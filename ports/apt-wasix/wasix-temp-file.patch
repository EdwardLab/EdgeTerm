    int iFd;
  
    enum LocalFlags {AutoClose = (1<<0),Fail = (1<<1),DelOnFail = (1<<2),
-                    HitEof = (1<<3), Replace = (1<<4), Compressed = (1<<5) };
+                    HitEof = (1<<3), Replace = (1<<4), Compressed = (1<<5),
+                    DelOnClose = (1<<6) };
