    std::string TemporaryFileName;
@@ -154,6 +155,7 @@ class APT_PUBLIC FileFd
    inline bool IsOpen() {return iFd >= 0;};
    inline bool Failed() {return (Flags & Fail) == Fail;};
    inline void EraseOnFailure() {Flags |= DelOnFail;};
