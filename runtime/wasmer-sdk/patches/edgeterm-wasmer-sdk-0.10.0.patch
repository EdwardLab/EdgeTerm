+#[derive(Default, PartialEq, Eq)]
+struct FileSystemSnapshot {
+    directories: BTreeSet<PathBuf>,
+    files: BTreeMap<PathBuf, Vec<u8>>,
+}
+
+fn snapshot_file_system(
+    fs: &dyn FileSystem,
+    source_root: &Path,
+) -> anyhow::Result<FileSystemSnapshot> {
+    fn visit(
+        fs: &dyn FileSystem,
+        source_root: &Path,
+        relative: &Path,
+        snapshot: &mut FileSystemSnapshot,
+    ) -> anyhow::Result<()> {
+        let current = source_root.join(relative);
+        let entries = fs
+            .read_dir(&current)
+            .with_context(|| format!("Unable to read {}", current.display()))?;
+        for entry in entries {
+            let entry = entry?;
+            let name = entry.file_name();
+            let child_relative = relative.join(name);
+            let child_source = source_root.join(&child_relative);
+            let file_type = entry.file_type()?;
+            if file_type.is_dir() {
+                snapshot.directories.insert(child_relative.clone());
+                visit(fs, source_root, &child_relative, snapshot)?;
+                continue;
+            }
+            if file_type.is_file() {
+                let mut options = fs.new_open_options();
+                options.read(true);
+                let mut file = options.open(&child_source)?;
+                let mut bytes = Vec::with_capacity(file.size() as usize);
+                block_on(file.read_to_end(&mut bytes))?;
+                snapshot.files.insert(child_relative, bytes);
+            }
+        }
+        Ok(())
+    }
+
+    let mut snapshot = FileSystemSnapshot::default();
+    visit(fs, source_root, Path::new(""), &mut snapshot)?;
+    Ok(snapshot)
+}
+
+fn replace_directory_contents(
+    directory: &Directory,
+    source: &FileSystemSnapshot,
+) -> anyhow::Result<()> {
+    let before = snapshot_file_system(directory, Path::new("/"))?;
+    if before == *source {
+        return Ok(());
+    }
+
+    for path in before.files.keys().filter(|path| !source.files.contains_key(*path)) {
+        FileSystem::remove_file(directory, &Path::new("/").join(path))?;
+    }
+    let mut removed_directories = before
+        .directories
+        .iter()
+        .filter(|path| !source.directories.contains(*path))
+        .collect::<Vec<_>>();
+    removed_directories.sort_by_key(|path| std::cmp::Reverse(path.components().count()));
+    for path in removed_directories {
+        FileSystem::remove_dir(directory, &Path::new("/").join(path))?;
+    }
+    for path in &source.directories {
+        let path = Path::new("/").join(path);
+        if FileSystem::read_dir(directory, &path).is_err() {
+            virtual_fs::create_dir_all(directory, &path)?;
+        }
+    }
+    for (path, bytes) in &source.files {
+        let path = Path::new("/").join(path);
+        if let Some(parent) = path.parent() {
+            virtual_fs::create_dir_all(directory, parent)?;
+        }
+        let mut options = directory.new_open_options();
+        options.write(true).create(true).truncate(true);
+        let mut file = options.open(&path)?;
+        block_on(file.write_all(bytes))?;
+        block_on(file.flush())?;
+    }
+    Ok(())
+}
+
+fn synchronize_mounted_directories(
+    root_fs: &dyn FileSystem,
+    mounted_directories: &[(String, Directory)],
+) -> anyhow::Result<()> {
+    for (guest_path, directory) in mounted_directories {
+        if !guest_path.starts_with('/') {
+            return Err(anyhow!("Relative runtime mount is not supported: {guest_path:?}"));
+        }
+        let guest_path = Path::new(guest_path);
+        let snapshot = snapshot_file_system(root_fs, guest_path)
+            .with_context(|| format!("Unable to snapshot mount {}", guest_path.display()))?;
+        replace_directory_contents(directory, &snapshot)
+            .with_context(|| format!("Unable to persist mount {}", guest_path.display()))?;
+    }
+    Ok(())
+}
